# ─── Magnat Furniture — Environment Variables ─────────────────────────────────
# Copy this file to .env.local and fill in all values before deploying

# ── Google Analytics 4 ────────────────────────────────────────────────────────
# Get from: https://analytics.google.com > Admin > Data Streams
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Google Tag Manager (optional, use instead of direct GA4) ─────────────────
# Get from: https://tagmanager.google.com
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ── Supabase (if using database for products/blog) ───────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Site URL (important for canonical and og:url) ────────────────────────────
NEXT_PUBLIC_SITE_URL=https://magnat.in

# ── WhatsApp Business Number ─────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# ── Contact Phone ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_PHONE=+91-9876543210

# ── Contact Email ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_EMAIL=info@magnat.in

# ── Cloudinary (for image uploads) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
